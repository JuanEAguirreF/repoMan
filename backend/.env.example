PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Direct Postgres connection string (Supabase -> Connect -> URI)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Cloudinary (for public cover images only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=repoman/covers

# Directory where protected files and cover images are stored.
# Keep this outside any public static web root.
STORAGE_ROOT=./uploads

# Byte limits
MAX_FILE_SIZE_BYTES=52428800
MAX_COVER_SIZE_BYTES=5242880
COVER_TARGET_MAX_WIDTH=400
COVER_TARGET_MAX_BYTES=256000
